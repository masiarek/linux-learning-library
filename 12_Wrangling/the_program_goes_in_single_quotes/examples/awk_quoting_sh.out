10.0.0.9
10.0.1.4

$ printf 'a:b:c\n' | awk -F: '{print $2}'
b

$ awk 'END {print NR}' log.txt
4

$ printf '3\n4\n' | awk '{total += $1} END {print total}'
7

$ awk '$2 == "sshd:" {n++} END {print n}' log.txt
4

$ cat report.sh
awk "{print $1}" log.txt

