$ find src | sort
src
src/a.txt
src/b.txt

$ cp -R src dst; find dst | sort
dst
dst/a.txt
dst/b.txt

$ cp -R src dst; find dst | sort
dst
dst/a.txt
dst/b.txt
dst/src
dst/src/a.txt
dst/src/b.txt

$ cp -R src/ slash; find slash | sort
slash
slash/a.txt
slash/b.txt

$ cp -R src/ slash; find slash | sort
slash
slash/a.txt
slash/b.txt

