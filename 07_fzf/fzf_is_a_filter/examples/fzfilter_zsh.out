$ fzf --filter rdme < files.txt; echo "status $?"
README.md
docs/README.md
status 0

$ fzf --filter zzz < files.txt || echo "no match, status $?"
no match, status 1

$ FZF_DEFAULT_OPTS=--exact fzf --filter mngo < files.txt; echo "status $?"
status 1

$ q="main go"; fzf --filter $q < files.txt; echo "status $?"
src/main.go
src/main_test.go
status 0

$ q="main go"; fzf --filter ${=q} < files.txt; echo "status $?"
unknown option: go
status 2

