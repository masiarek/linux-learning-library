$ mkdir locked; chmod 555 locked

$ echo "new line" > locked/notes.txt; echo "status $status"
warning: An error occurred while redirecting file 'locked/notes.txt'
open: Permission denied
status 1

$ echo "new line" | tee locked/notes.txt; echo "pipestatus $pipestatus"
tee: locked/notes.txt: Permission denied
new line
pipestatus 0 1

$ rm -f ran; sh -c "touch ran; echo new line" > locked/notes.txt; if test -e ran; echo "the command ran"; else; echo "the command never ran"; end
warning: An error occurred while redirecting file 'locked/notes.txt'
open: Permission denied
the command never ran

$ rm -f ran; sh -c "touch ran; echo new line" | tee locked/notes.txt > /dev/null; if test -e ran; echo "the command ran"; else; echo "the command never ran"; end
tee: locked/notes.txt: Permission denied
the command ran

$ chmod 755 locked

